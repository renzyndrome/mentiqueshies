# Required. Passcode the media team types on /admin. Sent as the x-admin-key header.
# Use a long random value, for example: openssl rand -base64 24
ADMIN_KEY=

# Public address of the site. Used for the QR code and the footer text.
PUBLIC_URL=https://mentiqueshie.questlaguna.org

# Folder for respond.sqlite. Docker uses /data (mount a volume there).
DATA_DIR=./data

# HTTP port.
PORT=3000
